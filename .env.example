# PocketBase Configuration
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=seu-senha-admin-segura
POCKETBASE_DIR=./pb

# SMTP Configuration (Fallback/Legacy)
SMTP_SERVICE=gmail
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email Settings (Fallback/Legacy)
MAIL_FROM=XML Sender <your-email@gmail.com>
MAIL_TO=accountant@example.com

# Application
APP_DATA_DIR=./data
DEFAULT_ZIP_PATH=./xmlfiles.zip

# Debug
DEBUG=false
