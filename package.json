{
  "name": "xml-sender",
  "version": "4.1.0",
  "productName": "XML Sender App",
  "description": "Aplicativo de envio de pacotes XML's via email com PocketBase.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --debug",
    "build": "electron-builder",
    "dist": "node scripts/build-all.js",
    "dist:all": "electron-builder --mac --win --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "pocketbase": "pocketbase serve"
  },
  "author": "Wander Pereira",
  "license": "MIT",
  "build": {
    "appId": "com.wanderpereira.xmlsender",
    "productName": "XML Sender App",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business"
    },
    "win": {
      "target": ["nsis", "zip"],
      "publisherName": "Wander Pereira"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.9",
    "dotenv": "^16.0.3",
    "moment": "^2.29.4",
    "nodemailer": "^8.0.5",
    "pocketbase": "^0.20.0",
    "xml-js": "^1.6.11",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^24.4.0",
    "electron-is-dev": "^2.0.0"
  }
}
